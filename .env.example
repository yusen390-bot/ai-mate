# ============================================================
#  AI Mate 环境变量示例
#  用法：复制为 .env 后填入你自己的值（.env 已被 .gitignore 忽略，不会提交）
#  PowerShell:  Copy-Item .env.example .env
# ============================================================

# ---------- 服务端口 ----------
PORT=3001

# ---------- 模型服务（OpenAI 兼容格式）----------
# 只要改这三行，就能在 OpenAI / DeepSeek / Kimi / 通义 / 本地 Ollama 之间切换
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_API_KEY=sk-替换成你自己的密钥
MODEL_NAME=gpt-4o-mini
MODEL_TIMEOUT_MS=60000

# ---------- 常见服务填写示例 ----------
# OpenAI      : MODEL_BASE_URL=https://api.openai.com/v1
#               MODEL_NAME=gpt-4o-mini
# DeepSeek    : MODEL_BASE_URL=https://api.deepseek.com/v1
#               MODEL_NAME=deepseek-chat
# Kimi/Moonshot: MODEL_BASE_URL=https://api.moonshot.cn/v1
#               MODEL_NAME=moonshot-v1-8k
# 通义千问     : MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#               MODEL_NAME=qwen-plus
# 本地 Ollama : MODEL_BASE_URL=http://localhost:11434/v1
#               MODEL_NAME=llama3.1
#               MODEL_API_KEY=ollama   （本地服务随便填一个非空值）

# ---------- 数据库 ----------
# 留空 = server/data/ai-mate.db
DB_FILE=